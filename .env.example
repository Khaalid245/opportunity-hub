# ==============================================================================
# Environment Configuration Template (Verified Job & Career Platform)
# Copy this file to .env and adjust values for local development or production.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=django-insecure-change-this-secret-key-in-production-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database Settings (PostgreSQL) ---
POSTGRES_DB=opportunity_db
POSTGRES_USER=opportunity_user
POSTGRES_PASSWORD=opportunity_secure_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- JWT Authentication Settings ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS Settings ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Frontend Settings ---
VITE_API_BASE_URL=http://localhost:8000/api
